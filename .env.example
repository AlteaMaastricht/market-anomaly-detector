# Environment variables for Market Anomaly Detector
# Copy this file to .env and fill in your own values. Never commit .env.

# Data source: "auto" (Yahoo Finance -> Alpha Vantage -> synthetic fallback)
#              "synthetic" (offline, deterministic seeded GBM; no network)
DATA_SOURCE=synthetic

# Alpha Vantage API Key (optional - backup data source when DATA_SOURCE=auto)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# SQLite database file used by the API
DATABASE_PATH=market_data.db

# Directory for persisted models (joblib). Leave empty to disable saving.
MODEL_DIR=

# Set to 0 to disable the periodic update/detection background tasks
ENABLE_BACKGROUND_TASKS=1
